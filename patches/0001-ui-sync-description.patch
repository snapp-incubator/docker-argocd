From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Raha Alizade <53145698+rahaalizade@users.noreply.github.com>
Date: Wed, 7 Oct 2026 18:50:14 +0330
Subject: [PATCH 1/2] feat(ui): add optional sync description field stored in
 operation info (#29983)

Ported to the 3.6 layout: the form moved from application-sync-panel.tsx into application-sync-panel-body.tsx.

Signed-off-by: Raha Alizade <raha.alizade@Snapp-Box.com>
Co-authored-by: Raha Alizade <raha.alizade@Snapp-Box.com>
Co-authored-by: Claude Code <noreply@anthropic.com>
---
 .../application-sync-panel-body.tsx                    | 10 ++++++++--
 ui/src/app/shared/services/applications-service.ts     |  6 ++++--
 2 files changed, 12 insertions(+), 4 deletions(-)

diff --git a/ui/src/app/applications/components/application-sync-panel/application-sync-panel-body.tsx b/ui/src/app/applications/components/application-sync-panel/application-sync-panel-body.tsx
index 8c1134b..91e63f3 100644
--- a/ui/src/app/applications/components/application-sync-panel/application-sync-panel-body.tsx
+++ b/ui/src/app/applications/components/application-sync-panel/application-sync-panel-body.tsx
@@ -45,7 +45,8 @@ export const ApplicationSyncPanelBody = ({
                     defaultValues={{
                         revision: new URLSearchParams(ctx.history.location.search).get('revision') || source.targetRevision || 'HEAD',
                         resources: appResources.map((_, i) => i === syncResIndex || syncResIndex === -1),
-                        syncOptions: application.spec.syncPolicy ? application.spec.syncPolicy.syncOptions : []
+                        syncOptions: application.spec.syncPolicy ? application.spec.syncPolicy.syncOptions : [],
+                        message: ''
                     }}
                     validateError={values => ({
                         resources: values.resources.every((item: boolean) => !item) && 'Select at least one resource'
@@ -220,7 +221,8 @@ export const ApplicationSyncPanelBody = ({
                                 syncStrategy,
                                 selectedResources,
                                 params.syncOptions,
-                                params.retryStrategy
+                                params.retryStrategy,
+                                params.message
                             );
                             hide();
                         } catch (e) {
@@ -242,6 +244,10 @@ export const ApplicationSyncPanelBody = ({
                                 <FormField formApi={formApi} label='Revision' field='revision' component={Text} />
                             </div>
 
+                            <div className='argo-form-row'>
+                                <FormField formApi={formApi} label='Sync description (optional)' field='message' component={Text} />
+                            </div>
+
                             <div className='argo-form-row'>
                                 <div style={{marginBottom: '1em'}}>
                                     <FormField formApi={formApi} field='syncFlags' component={ApplicationManualSyncFlags} />
diff --git a/ui/src/app/shared/services/applications-service.ts b/ui/src/app/shared/services/applications-service.ts
index 9c0069a..c9e39f8 100644
--- a/ui/src/app/shared/services/applications-service.ts
+++ b/ui/src/app/shared/services/applications-service.ts
@@ -290,7 +290,8 @@ export class ApplicationsService {
         strategy: models.SyncStrategy,
         resources: models.SyncOperationResource[],
         syncOptions?: string[],
-        retryStrategy?: models.RetryStrategy
+        retryStrategy?: models.RetryStrategy,
+        message?: string
     ): Promise<boolean> {
         return requests
             .post(`/applications/${name}/sync`)
@@ -302,7 +303,8 @@ export class ApplicationsService {
                 strategy,
                 resources,
                 syncOptions: syncOptions ? {items: syncOptions} : null,
-                retryStrategy
+                retryStrategy,
+                infos: message ? [{name: 'message', value: message} as models.Info] : []
             })
             .then(() => true);
     }
